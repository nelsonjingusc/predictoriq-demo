# Demo Mode - Use mock data instead of real API calls
NEXT_PUBLIC_DEMO_MODE=true

# API URL (only used when DEMO_MODE=false)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Formspree ID for waitlist email notifications (e.g. 'xbjebpoy')
# Get one for free at https://formspree.io/
NEXT_PUBLIC_FORMSPREE_ID=

# WalletConnect Project ID (required for wallet connection)
# Get one for free at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Kalshi API Key (optional, may be required for Kalshi API access)
# Sign up at: https://kalshi.com
KALSHI_API_KEY=
